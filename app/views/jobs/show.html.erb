<turbo-frame id="job-detail">
  <div class="drawer-header">
    <h2 class="drawer-title"><%= @job.title %></h2>
    <button class="drawer-close" data-action="click->drawer#close">&times;</button>
  </div>

  <div class="drawer-body">
    <div class="drawer-meta">
      <%= status_badge(@job.status) %>
      <span class="job-card-tag"><%= @job.job_category.name %></span>
    </div>

    <p class="drawer-description"><%= @job.details %></p>

    <div class="drawer-section">
      <p class="drawer-label">Budget</p>
      <p class="drawer-value">FCFA <%= number_with_delimiter(@job.price_range_min.to_i) %> – <%= number_with_delimiter(@job.price_range_max.to_i) %></p>
    </div>

    <% if @job.address %>
      <div class="drawer-section">
        <p class="drawer-label">Location</p>
        <p class="drawer-value"><%= @job.address.name %></p>
      </div>
    <% end %>

    <% if @latest_assignment %>
      <div class="drawer-section">
        <p class="drawer-label">Technician</p>
        <div class="drawer-assignment">
          <p class="drawer-value">
            <%= @latest_assignment.technician.user.first_name %>
            <%= @latest_assignment.technician.user.last_name %>
          </p>
          <%= status_badge(@latest_assignment.status) %>
        </div>
      </div>

      <% if @work_order %>
        <div class="drawer-section">
          <p class="drawer-label">Work Order</p>
          <%= status_badge(@work_order.status) %>

          <% if @work_order.status == "quote_submitted" %>
            <p class="status-card-meta" style="margin-top: var(--space-2)">The technician has submitted a quote for your approval.</p>
            <div class="drawer-actions">
              <%= link_to "Review & Approve Quote", work_order_details_path(@work_order), class: "button" %>
            </div>

          <% elsif @work_order.status == "quote_approved" %>
            <p class="status-card-meta" style="margin-top: var(--space-2)">Quote approved. Technician is preparing to start work.</p>

          <% elsif @work_order.status == "in_progress" %>
            <p class="status-card-meta" style="margin-top: var(--space-2)">Work is currently in progress.</p>

          <% elsif @work_order.status == "on_hold" %>
            <p class="status-card-meta" style="margin-top: var(--space-2)">Work is paused.</p>

          <% elsif @work_order.status == "completed" %>
            <p class="status-card-meta" style="margin-top: var(--space-2)">
              Work completed in <%= @work_order.formatted_duration %>.
              Total billed: FCFA <%= number_with_delimiter(@work_order.line_items.sum(:amount).to_i) %>.
            </p>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="drawer-section">
        <p class="drawer-label">Assignment</p>
        <p class="status-card-meta">Finding a technician for your job...</p>
      </div>
    <% end %>

    <% if @job.media.attached? %>
      <div class="drawer-section">
        <p class="drawer-label">Photos</p>
        <div class="job-card-media">
          <% @job.media.each do |file| %>
            <%= image_tag file, class: "job-card-thumb" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="drawer-timestamp">Posted <%= time_ago_in_words(@job.created_at) %> ago</p>

    <div class="drawer-section">
      <%= render "comments/comments", commentable: @job, url: job_comments_path(@job) %>
    </div>
  </div>
</turbo-frame>
