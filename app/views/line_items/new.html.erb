<div class="auth-form">
  <h1>Add Line Item</h1>
  <%= form_with model: @line_item, url: create_new_line_item_path(@work_order) do |form| %>
    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 4, class: "details-container" %>
      <%= field_error(@line_item, :description) %>
    </div>
    <div class="form-group">
      <%= form.label :amount %>
      <%= form.number_field :amount, step: 0.01, placeholder: "e.g. 5000" %>
      <%= field_error(@line_item, :amount) %>
    </div>
    <div class="button-container">
      <%= form.submit "Add Item", class: "button" %>
    </div>
  <% end %>
</div>
