<div class="dashboard">
  <%# <div class="dashboard-header">
    <h1>Hello,  current_user.first_name</h1>
     link_to "Post a Job", new_job_path, class: "button" 
  </div> %>

  <div class="dashboard-search">
    <div class="dashboard-search-wrapper">
      <svg class="dashboard-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" class="dashboard-search-input" placeholder="Search jobs...">
    </div>
  </div>

  <% if @pending_quotes.any? %>
    <section class="dashboard-section">
      <h2 class="section-title">Quotes Awaiting Approval</h2>
      <% @pending_quotes.each do |work_order| %>
        <div class="status-card">
          <div class="status-card-top">
            <div>
              <p class="status-card-title"><%= work_order.assignment.job.title %></p>
              <p class="status-card-meta">Quote submitted by technician</p>
            </div>
            <%= status_badge(work_order.status) %>
          </div>
          <p class="status-card-price">
            FCFA <%= number_with_delimiter(work_order.line_items.sum(:amount).to_i) %> total
          </p>
          <div class="button-container">
            <%= link_to "Review Quote", work_order_details_path(work_order), class: "button" %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @active_jobs.any? %>
    <section class="dashboard-section">
      <h2 class="section-title">Active Jobs</h2>
      <% @active_jobs.each do |job| %>
        <div class="status-card">
          <div class="status-card-top">
            <div>
              <p class="status-card-title"><%= job.title %></p>
              <p class="status-card-meta"><%= job.job_category.name %></p>
            </div>
            <%= status_badge(job.status) %>
          </div>

          <p class="status-card-description"><%= truncate(job.details, length: 120, omission: "") %></p>

          <% latest_assignment = job.assignments.max_by(&:created_at) %>
          <% if latest_assignment %>
            <div class="status-card-assignment">
              <p class="status-card-meta">
                Technician: <strong><%= latest_assignment.technician.user.first_name %></strong>
              </p>
              <%= status_badge(latest_assignment.status) %>
            </div>
          <% else %>
            <p class="status-card-meta muted">Finding a technician...</p>
          <% end %>

          <p class="status-card-price">
            FCFA <%= number_with_delimiter(job.price_range_min.to_i) %> – <%= number_with_delimiter(job.price_range_max.to_i) %>
          </p>
        </div>
      <% end %>
    </section>
  <% else %>
    <div class="empty-state">
      <p>No active jobs right now.</p>
      <%= link_to "Post your first job", new_job_path, class: "button" %>
    </div>
  <% end %>

  <% if @recent_jobs.any? %>
    <section class="dashboard-section">
      <div class="section-header">
        <h2 class="section-title">Recent</h2>
        <%= link_to "See all", jobs_path, class: "section-link" %>
      </div>
      <% @recent_jobs.each do |job| %>
        <div class="status-card status-card--muted">
          <div class="status-card-top">
            <p class="status-card-title"><%= job.title %></p>
            <%= status_badge(job.status) %>
          </div>
          <p class="status-card-meta"><%= job.job_category.name %></p>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
