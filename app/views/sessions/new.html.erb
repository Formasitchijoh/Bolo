<div class="auth-container">
    <div class="auth-image">
        <%= image_tag "front-cover.png", alt: "Auth cover" %>
    </div>
    <div class="auth-form">
        <h1>Login</h1>
        <%= form_with  url: login_path do |form| %>
            <div class="form-group">
                <%= form.label :email %>
                <%= form.email_field :email %>
            </div>
            <div class="form-group">
                <%= form.label :password %>
                <%= form.password_field :password %>
            </div>
            <div class="form-group">
                 <%= link_to "Don't have an account? Register here.", register_path %>
            </div>
            <div class="button-container">
            <%= form.submit("Login") %>
            </div>
        <% end %>
    </div>
</div>