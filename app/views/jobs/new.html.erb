<div class="form-container" data-controller="location">
  <%= form_with model: @job, url: jobs_path do |form| %>

    <div class="form-group">
      <%= form.label :title, "Job title" %>
      <%= form.text_field :title %>
      <%= field_error(@job, :title) %>
    </div>

    <div class="form-group">
      <%= form.label :company_id, "Company (Optional)" %>
      <%= form.collection_select :company_id, @companies, :id, :name, { prompt: "Select Company (leave blank to broadcast to all)" } %>
    </div>

    <div class="form-group">
      <%= form.label :job_category_id, "Job Category" %>
      <%= form.collection_select :job_category_id, @job_categories, :id, :name, { prompt: "Select Job Category" } %>
      <%= field_error(@job, :job_category_id) %>
    </div>

    <div class="form-group">
      <%= form.label :price_range_min, "Minimum Price (FCFA)" %>
      <%= form.number_field :price_range_min, step: 0.01, placeholder: "e.g. 5000" %>
      <%= field_error(@job, :price_range_min) %>
    </div>

    <div class="form-group">
      <%= form.label :price_range_max, "Maximum Price (FCFA)" %>
      <%= form.number_field :price_range_max, step: 0.01, placeholder: "e.g. 15000" %>
      <%= field_error(@job, :price_range_max) %>
    </div>

    <div class="location-field">

      <div class="location-form-group">
        <%= label_tag :address, "Job Location" %>
        <%= text_field_tag :address, nil,
              data: {
                location_target: "address",
                action: "input->location#searchAddress"
              },
              placeholder: "Enter your Address" %>
      </div>
        <button class="cta-button" type="button"
                data-action="click->location#useCurrentLocation">
          Use my location
        </button>
    </div>
    <span data-location-target="status" class="location-status"></span>

    <div class="form-group ">
      <%= form.label :details, "Job Details" %>
      <%= form.text_area :details, rows: 4, class: "details-container", placeholder: "Describe the job in detail..." %>
      <%= field_error(@job, :details) %>
    </div>


    <%= form.hidden_field :latitude, data: { location_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { location_target: "longitude" } %>

    <div class="form-group" data-controller="file-preview">
      <%= form.label :media, "Photos" %>
      <%= form.file_field :media,
            multiple: true,
            accept: "image/*",
            data: {
              file_preview_target: "input",
              action: "change->file-preview#show"
            } %>
      <div data-file-preview-target="preview" class="preview-grid"></div>
    </div>

    <div class="button-container">
      <button class="button" type="submit">
         <%= form.submit "Post Job", class: "button" %>
      </button>
    </div>

  <% end %>
</div>
