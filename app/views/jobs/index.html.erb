<div class="job-actions">
    <button class="button">
         <%= link_to "Post New Job", jobs_new_path, class: "button" %>
    </button>
</div>
<% @jobs.each  do |job| %>
    <div class="job-card">
        <h2><%= job.title%></h2>
        <span class="username">By: <%= job.customer.user.first_name %> <%= job.customer.user.last_name %></span>
        <p class="details"><%= job.details %></p>
    </div>
<% end %>