<div class="auth-container">
    <div class="auth-image">
        <%= image_tag "front-cover.png", alt: "Auth cover" %>
    </div>
    <div class="auth-form">
        <h1>Register</h1>
        <%= form_with model: @user, url: register_path do |form| %>
        <div class="form-group">
            <%= form.label :first_name %>
            <%= form.text_field :first_name %>
        </div>
        <div class="form-group">
            <%= form.label :last_name %>
            <%= form.text_field :last_name %>
        </div>
        <div class="form-group">
            <%= form.label :email %>
            <%= form.email_field :email %>
        </div>
        <div class="form-group">
            <%= form.label :role %>
            <%= form.select :role, %w[customer technician dispatcher company_admin account_owner] %>
        </div>

        <div class="form-group">
            <%= form.label :password %>
            <%= form.password_field :password %>
        </div>
        <div class="form-group">
            <%= form.label :password_confirmation %>
            <%= form.password_field :password_confirmation %>
        </div>
        <div class="form-group">
            <%= link_to "Already have an account? Login here.", login_path %>
        </div>
        <div class="button-container">
             <%= form.submit("Register") %>
        </div>

        <% end %>
    </div>
</div>